# ─────────────────────────────────────────────────────────────────────────────
# The Show Verse — Web (Next.js) · plantilla de variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
#   cp .env.example .env            # valores base
# Para DESARROLLO LOCAL, Next.js carga automáticamente `.env.local` (tiene
# prioridad sobre `.env`): pon ahí las URLs que apunten al backend local.
#
# NUNCA se versionan `.env` ni `.env.*` (salvo este `.env.example`).

# ── TMDB (catálogo) ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_* se hornean en el bundle del cliente (build-time).
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
TMDB_V4_ACCESS_TOKEN=your-tmdb-v4-read-access-token
OMDB_API_KEY=your-omdb-api-key

# ── Backend propio (BBDD: favoritos, pendientes, historial, dashboards) ──────
# LOCAL: apunta al backend Fastify local. En .env.local pon http://localhost:3001
BACKEND_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ── Trakt (integración opcional) ─────────────────────────────────────────────
TRAKT_CLIENT_ID=your-trakt-client-id
TRAKT_CLIENT_SECRET=your-trakt-client-secret
TRAKT_REDIRECT_URI=http://localhost:3000/api/trakt/auth/callback

# ── Google OAuth (login) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── IA local (Ollama) ────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Spotify (soundtracks) ────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token

# ── Plex (integración opcional) ──────────────────────────────────────────────
PLEX_URL=http://your-plex-host:32400
PLEX_TOKEN=your-plex-token
PLEX_CLIENT_IDENTIFIER=the-show-verse
PLEX_JWT_SCOPE=your-plex-jwt-scope
PLEX_JWT_KID=your-plex-jwt-kid
PLEX_JWT_PRIVATE_KEY=your-plex-jwt-private-key

# ── Acceso privado (gate de la web, a nivel de DISPOSITIVO) ──────────────────
# Bloquea TODA la web: cualquier dispositivo NO autorizado recibe 404 (sin
# revelar contenido). No usa el login de usuario: la autorización es por
# dispositivo mediante una llave privada.
#
# ACTIVACIÓN: el gate SOLO actúa si SHOWVERSE_PRIVATE_ACCESS_KEY tiene valor.
# Despliegue en NAS: define la llave SOLO en el entorno del NAS (este `.env` en
# el servidor). En desarrollo local, deja la llave vacía / no la definas y la web
# queda abierta. Funciona por HTTP o HTTPS (la cookie ajusta `secure` al
# protocolo real de la petición).
SHOWVERSE_PRIVATE_ACCESS_KEY=changeme
#
# Autorizar un dispositivo (una vez por navegador; cookie httpOnly de 1 año).
# Sustituye <URL-DE-TU-NAS> por cómo accedes al NAS (dominio o IP:puerto):
#   <URL-DE-TU-NAS>/api/private-access?key=<LA-LLAVE>
#   p. ej.  http://192.168.1.50:3000/api/private-access?key=<LA-LLAVE>
# Revocar el dispositivo actual:  DELETE <URL-DE-TU-NAS>/api/private-access
#
# HOSTS (OPCIONAL): lista separada por comas de dominios/hosts donde actúa el
# gate. Déjalo VACÍO para que actúe en cualquier host donde esté la llave (lo
# normal en un NAS accedido por IP o por varios nombres). Rellénalo solo si
# quieres restringir a hosts concretos. Admite comodín de subdominio "*."
# (p. ej. *.midominio.com).
SHOWVERSE_PRIVATE_ACCESS_HOSTS=

# ── Red del servidor (portadas personalizadas en móvil) ──────────────────────
# En VISTA MÓVIL y entrando desde FUERA, la ficha renuncia a las portadas
# personalizadas: comprobarlas es una ida y vuelta al NAS por el túnel y es lo
# único que retrasa el inicio de la descarga de la portada. Se usa el criterio
# automático, que descarga del mismo CDN de TMDb. Al llegar a "Portadas y
# fondos" sí se consulta, para poder ver qué imagen tienes elegida.
#
# "Desde fuera" se decide por el HOST con el que se ha cargado la web. Ya se
# reconocen solos: localhost, rangos privados (10.x, 192.168.x, 172.16-31.x),
# link-local y los sufijos .local/.lan/.home/.internal.
#
# HOSTS EXTRA (OPCIONAL): lista separada por comas de hosts que también son "tu
# red" aunque no encajen en lo anterior (un nombre resuelto por DNS interno,
# p. ej.). Admite el mismo comodín "*." de subdominio. Es NEXT_PUBLIC_ porque la
# decisión se toma en el navegador, antes de cualquier petición: cambiarlo
# obliga a reconstruir.
NEXT_PUBLIC_SHOWVERSE_LOCAL_HOSTS=
