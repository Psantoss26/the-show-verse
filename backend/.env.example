# ─────────────────────────────────────────────────────────────────────────────
# The Show Verse — Backend API · plantilla de variables de entorno
# ─────────────────────────────────────────────────────────────────────────────
# Copia este fichero a `.env` (producción/valores base) y, para DESARROLLO LOCAL,
# crea además un `.env.local` que SOBREESCRIBE solo lo que cambie (BBDD, Redis…).
# .env.local solo se carga fuera de production/test. npm run dev lo prepara.
#
#   cp backend/.env.example backend/.env
#
# NUNCA se versiona `.env` ni `.env.local` (ver .gitignore).

# ── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ── Base de datos (PostgreSQL) ───────────────────────────────────────────────
# LOCAL (compose deploy/local): usuario tsv / pass tsv / db theshowverse.
#   sslmode=disable → Postgres local sin TLS.
DATABASE_URL=postgresql://tsv:tsv@localhost:5432/theshowverse?sslmode=disable
# Conexión DIRECTA (sin PgBouncer) para migraciones. Autoalojado (NAS): misma que
# DATABASE_URL. Solo cambia si algún día se pusiera un pooler delante.
DATABASE_URL_UNPOOLED=postgresql://tsv:tsv@localhost:5432/theshowverse?sslmode=disable

# ── Redis (opcional: sin él, la app corre SIN caché) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── Autenticación (JWT) ──────────────────────────────────────────────────────
# Genera secretos con:  openssl rand -base64 48
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── URLs / CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── APIs externas ────────────────────────────────────────────────────────────
TMDB_API_KEY=your-tmdb-api-key
TRAKT_CLIENT_ID=your-trakt-client-id
TRAKT_CLIENT_SECRET=your-trakt-client-secret

# ── Google OAuth (login) ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Stripe (suscripciones) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Planes de pago (ver docs/features/planes-y-suscripciones.md).
BILLING_ENABLED=0
BILLING_LAUNCH_AT=
BILLING_GRACE_DAYS=30
STRIPE_PRICE_ADFREE_MONTH=
STRIPE_PRICE_ADFREE_YEAR=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_AUTOMATIC_TAX=0

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@theshowverse.com

# ── IA (API de modelos de NVIDIA) para sentimientos de comunidad ─────────────
# Sin clave se queda el resumen heurístico.
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b,mistralai/mistral-large-4-1t-a52b

# ── Notificaciones del dispositivo (opcional) ────────────────────────────────
# Web Push (navegador, PWA, escritorio). Generar con:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@theshowverse.com
# Firebase Cloud Messaging (app de Android): JSON de la cuenta de servicio de
# Firebase (Configuración del proyecto → Cuentas de servicio → Generar clave),
# en una línea o en base64.
FCM_SERVICE_ACCOUNT_JSON=

# ── Ajustes opcionales (rendimiento / operación) ─────────────────────────────
# MIGRATIONS_FOLDER=./drizzle
# DASHBOARD_POOL_WARM_MS=0          # 0 = calienta pools al arrancar
# DASHBOARD_POOL_MEM_TTL_MS=300000  # TTL caché de pools en memoria (5 min)
# DB_KEEPALIVE_MS=240000            # ping periódico para mantener viva la conexión
# SOCIAL_BOTS_MS=600000            # tic de los usuarios automáticos de Social (10 min en producción;
#                                   # desactivado en local salvo que se fije; 0 = desactivado)
