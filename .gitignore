# --- Dependencias ---
node_modules/
.pnpm-store/

# --- Builds / Bundles ---
.next/
out/
dist/
build/
*.tsbuildinfo
.turbo/
.vercel/

# --- Entornos / secretos ---
# OJO: git NO admite comentarios en línea en .gitignore (el texto tras el patrón
# pasa a formar parte del propio patrón y lo rompe). Los comentarios van aparte.
# Ignora .env, .env.local, .env.development…; deja la plantilla .env.example.
.env
.env.*
!.env.example
# Ficheros de entorno de los despliegues (NAS): contienen secretos.
deploy/**/*.env

# --- Logs / depuración ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# --- Sistemas / editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
tmpclaude*
*.swp

# --- Cobertura / tests ---
coverage/
.nyc_output/

# --- Herramientas locales de agentes / specs ---
.agents/
.gstack/
.specify/
specs/

# Capturas/volcados de Playwright MCP (solo locales)
.playwright-mcp/

# Obsidian (configuración local del editor, no versionar)
.obsidian/
