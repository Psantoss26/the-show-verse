<?xml version="1.0" encoding="utf-8"?>
<!--
  Carcasa de la app: el WebView ocupa todo, con
   - `videoContainer` encima para los tráileres a pantalla completa,
   - `errorPanel` para los fallos de red y el gate de acceso privado.

  SIN barra de progreso: una app nativa no enseña una franja de carga cada vez
  que se navega, y la web ya tiene sus propios estados de carga.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tsv_black">

    <!-- Variante que cede los gestos HORIZONTALES a la página: sin ella, el
         contenedor se apropiaba del arrastre, el WebView mandaba un touchcancel
         y se rompía el deslizar entre secciones del perfil y las filas de
         carteles. -->
    <com.theshowverse.sync.HorizontalAwareSwipeRefresh
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.theshowverse.sync.HorizontalAwareSwipeRefresh>

    <!-- Vídeo a pantalla completa (lo rellena onShowCustomView). -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />


    <LinearLayout
        android:id="@+id/errorPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tsv_black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/tsv_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/web_retry" />

        <Button
            android:id="@+id/serverButton"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/server_title" />
    </LinearLayout>
</FrameLayout>
