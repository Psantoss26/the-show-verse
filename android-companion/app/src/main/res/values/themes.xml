<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema del panel nativo de sincronización (sigue el modo del sistema). -->
    <style name="Theme.TSVSync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowActionBar">false</item>
    </style>

    <!-- Tema de la app: SIEMPRE oscuro, porque la web lo es. Un tema claro haría
         que las barras del sistema y el fondo del WebView parpadearan en blanco
         al abrir y al navegar. -->
    <style name="Theme.TSV.Web" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/tsv_bg</item>
        <item name="android:statusBarColor">@color/tsv_bg</item>
        <item name="android:navigationBarColor">@color/tsv_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="colorPrimary">@color/tsv_amber</item>
    </style>

    <!-- Pantalla de arranque (androidx.core:core-splashscreen). Se mantiene hasta
         que la web tiene algo pintado, y da paso a Theme.TSV.Web. -->
    <style name="Theme.TSV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tsv_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TSV.Web</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/tsv_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/tsv_bg</item>
    </style>
</resources>
