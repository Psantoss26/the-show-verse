<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Necesario en Android 13+ para poder mostrar la notificación de estado. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ filtra qué apps puede "ver" la nuestra. Sin esto no se
         pueden resolver los enlaces externos (abrir en el navegador, o la ficha
         en la PWA desde The Show Verse Sync). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TSVSync">

        <!-- Recibe el deep link de emparejamiento: theshowverse://pair?token=&origin= -->
        <activity
            android:name=".PairingActivity"
            android:exported="true"
            android:noHistory="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="theshowverse" android:host="pair" />
            </intent-filter>
        </activity>

        <!-- REGISTRO DE DETECCIONES del móvil (las dos apps): lista y corrección
             nativas, con el token de vinculación. La web ya no las enseña. -->
        <activity
            android:name=".DeteccionesActivity"
            android:exported="false"
            android:label="@string/detections_title" />
        <activity
            android:name=".CorreccionActivity"
            android:exported="false"
            android:label="@string/correction_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Servicio que lee las sesiones multimedia de otras apps. Requiere que el
             usuario conceda "Acceso a notificaciones" en Ajustes. -->
        <service
            android:name=".MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Servicio de accesibilidad: detecta el título de la FICHA en apps de
             streaming sin reproducir. El usuario lo activa en Ajustes → Accesibilidad.
             Restringido a apps de streaming en accessibility_service_config.xml. -->
        <service
            android:name=".AccessibilityStreamingService"
            android:exported="true"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
