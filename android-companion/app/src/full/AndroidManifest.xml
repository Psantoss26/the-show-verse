<?xml version="1.0" encoding="utf-8"?>
<!-- Lo propio de la app COMPLETA (com.theshowverse.app): la web en un WebView y
     todo lo que la rodea. Se fusiona con src/main/AndroidManifest.xml. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- Para saber si The Show Verse Sync está instalada y cederle la
             sincronización (Delegacion). -->
        <package android:name="com.theshowverse.sync" />
    </queries>

    <application>

        <!-- LA APP: The Show Verse completo dentro de una carcasa nativa.
             `singleTask` para que los enlaces (App Links, notificaciones) reusen
             la instancia en vez de apilar copias. `configChanges` evita recrear
             la actividad al girar o al abrir el teclado: el WebView conserva la
             página, el scroll y el estado del formulario. -->
        <activity
            android:name=".WebAppActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density|navigation|fontScale|layoutDirection|locale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TSV.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: los enlaces a theshowverse.com abren la app en vez del
                 navegador. Requiere publicar /.well-known/assetlinks.json con la
                 huella SHA-256 del certificado de firma (ver docs). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="theshowverse.com" />
                <data android:scheme="https" android:host="www.theshowverse.com" />
            </intent-filter>

            <!-- Esquema propio: sirve como respaldo cuando la verificación de
                 App Links no está disponible (servidor propio, LAN…). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="theshowverse" android:host="open" />
            </intent-filter>
        </activity>

        <!-- Panel NATIVO de sincronización (permisos, apps, registro). Ya no es el
             punto de entrada: se abre desde la propia web (puente JS) o desde el
             enlace de emparejamiento. El nombre de clase se conserva para no
             romper referencias históricas. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/sync_panel_title"
            android:parentActivityName=".WebAppActivity" />

        <!-- Ajustes de servidor: origen que carga la app y clave de acceso
             privado. Pensado para probar contra el NAS o localhost. -->
        <activity
            android:name=".ServerActivity"
            android:exported="false"
            android:label="@string/server_title"
            android:parentActivityName=".WebAppActivity" />

        <!-- Diagnóstico de fluidez de la web (medidor y ajustes de prueba).
             Se abre desde el panel de sincronización. -->
        <activity
            android:name=".RendimientoActivity"
            android:exported="false"
            android:label="@string/perf_title"
            android:parentActivityName=".WebAppActivity" />

        <!-- Imágenes y vídeos que la web comparte con el selector del sistema
             (WebAppBridge.shareFile / shareImage). Sin exportar: el acceso lo da el
             permiso temporal del Intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shareimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_image_paths" />
        </provider>

        <!-- Notificaciones push (Firebase Cloud Messaging). Sin
             google-services.json en la build, Firebase no arranca y este
             servicio nunca recibe nada. -->
        <service
            android:name=".PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
