# ─────────────────────────────────────────────────────────────────────────────
# deploy/nas/.env — variables que INTERPOLA el docker-compose del NAS (${VAR}).
# Copiar a `deploy/nas/.env` en el NAS (NO se versiona; contiene secretos).
#   cp deploy/nas/.env.example deploy/nas/.env
# ─────────────────────────────────────────────────────────────────────────────

# Contraseña de la Postgres de producción (servicio `postgres`).
POSTGRES_PASSWORD=pon-una-password-fuerte

# Clave pública de TMDB horneada en el build de la web (NEXT_PUBLIC_*).
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key

# Token del túnel de Cloudflare (Zero Trust → Tunnels → tu túnel → token).
CF_TUNNEL_TOKEN=eyJ...tu-token-de-tunnel
