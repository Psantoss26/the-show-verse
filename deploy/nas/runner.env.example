# ─────────────────────────────────────────────────────────────────────────────
# deploy/nas/runner.env — self-hosted GitHub Actions runner (myoung34/github-runner).
# Copiar a `deploy/nas/runner.env` (NO se versiona).
# El runner ejecuta el workflow .github/workflows/deploy-nas.yml en el propio NAS.
# ─────────────────────────────────────────────────────────────────────────────

# Repositorio al que se registra el runner.
REPO_URL=https://github.com/TU_USUARIO/the-show-verse
RUNNER_SCOPE=repo

# Autenticación: un PAT (classic) con scope `repo` (el runner obtiene solo el
# token de registro efímero a partir de él). Alternativa: RUNNER_TOKEN puntual.
ACCESS_TOKEN=ghp_tu_personal_access_token

# Identidad y etiquetas (el workflow selecciona por `runs-on: [self-hosted, nas]`).
RUNNER_NAME=nas-ugreen
LABELS=self-hosted,nas,linux
RUNNER_WORKDIR=/tmp/runner/work

# Operación.
DISABLE_AUTO_UPDATE=true
EPHEMERAL=false
