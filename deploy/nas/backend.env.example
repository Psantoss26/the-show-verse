# ─────────────────────────────────────────────────────────────────────────────
# deploy/nas/backend.env — entorno del servicio `backend` (Fastify) en el NAS.
# Copiar a `deploy/nas/backend.env` (NO se versiona; contiene secretos).
# Nota: env_file NO interpola ${VAR}; escribe los valores literales.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# BBDD y caché → nombres de servicio de la red interna del compose.
# La contraseña debe COINCIDIR con POSTGRES_PASSWORD de deploy/nas/.env.
DATABASE_URL=postgresql://tsv:LA_MISMA_PASSWORD@postgres:5432/theshowverse
DATABASE_URL_UNPOOLED=postgresql://tsv:LA_MISMA_PASSWORD@postgres:5432/theshowverse
REDIS_URL=redis://redis:6379

# Secretos JWT (openssl rand -base64 48).
JWT_ACCESS_SECRET=pon-un-secreto-largo
JWT_REFRESH_SECRET=pon-otro-secreto-largo
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Origen público de la web (para CORS/redirecciones).
FRONTEND_URL=https://theshowverse.com

# APIs externas.
TMDB_API_KEY=your-tmdb-api-key
TRAKT_CLIENT_ID=your-trakt-client-id
TRAKT_CLIENT_SECRET=your-trakt-client-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://theshowverse.com/auth/callback
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RESEND_API_KEY=re_xxx
EMAIL_FROM=no-reply@theshowverse.com
