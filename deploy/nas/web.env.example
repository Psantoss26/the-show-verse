# ─────────────────────────────────────────────────────────────────────────────
# deploy/nas/web.env — entorno de RUNTIME del servicio `web` (Next.js) en el NAS.
# Copiar a `deploy/nas/web.env` (NO se versiona).
# Las NEXT_PUBLIC_* del cliente se hornean en el BUILD (args del compose), no aquí;
# aquí van las variables de servidor (rutas /api que llaman al backend, OAuth…).
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production

# La web llama al backend por la red interna del compose.
BACKEND_API_BASE_URL=http://backend:3001

# APIs usadas por las rutas de servidor de Next.
TMDB_API_KEY=your-tmdb-api-key
TMDB_V4_ACCESS_TOKEN=your-tmdb-v4-read-access-token
OMDB_API_KEY=your-omdb-api-key
TRAKT_CLIENT_ID=your-trakt-client-id
TRAKT_CLIENT_SECRET=your-trakt-client-secret
TRAKT_REDIRECT_URI=https://theshowverse.com/api/trakt/auth/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://theshowverse.com/auth/callback

# IA local (Ollama corre como servicio en el mismo NAS).
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1

# Integraciones opcionales.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REFRESH_TOKEN=your-spotify-refresh-token
PLEX_URL=http://your-plex-host:32400
PLEX_TOKEN=your-plex-token

# Gate de acceso privado.
SHOWVERSE_PRIVATE_ACCESS_KEY=changeme
